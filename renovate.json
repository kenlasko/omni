{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "enabledManagers": [
    "docker-compose",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^cluster\\-template\\-.*.yaml$"],
      "matchStrings": [
        "talos:\\s*\\n(?:\\s{2,})?version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "fileMatch": ["^cluster\\-template\\-.*.yaml$"],
      "matchStrings": [
        "kubernetes:\\s*\\n(?:\\s{2,})?version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "fileMatch": ["^patches/cluster\\-.*.yaml$"],
      "matchStrings": [
        "gateway\\-api\/releases\/download\/(?<currentValue>)\/experimental\\-install.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/gateway-api"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "matchManagers": ["docker-compose"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "matchUpdateTypes": [
        "major","minor","patch"
      ]
    }
  ]
}
